      "quotes": [
        {
          "sourceId": "umgc-catalog-2026-2027-degree-policies-2026-11-23",
          "text": "90 credits from all sources combined toward the bachelor’s degree"
        },
        {
          "sourceId": "umgc-catalog-2026-2027-degree-policies-2026-11-23",
          "text": "At least 30 credits (normally the final 30) must be completed at UMGC."
