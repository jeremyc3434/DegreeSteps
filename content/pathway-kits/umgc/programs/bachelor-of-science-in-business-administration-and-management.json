        {
          "sourceId": "umgc-catalog-2026-2027-degree-policies-2026-11-23",
          "text": "Half the required number of credits within the major (if you are not majoring in applied technology, described on p. 38, or general studies, described on p. 73) must be completed at UMGC."
        },
        {
          "sourceId": "umgc-catalog-2026-2027-degree-policies-2026-11-23",
          "text": "At least 15 credits of upper-level coursework (i.e., earned in courses numbered 300 to 499) must be completed at UMGC."
        }
      ],
