  "policyFacts": [
    {
      "id": "published-general-bachelor-cpl-cap",
      "value": 30,
      "creditSystem": "semester",
      "scope": "Published general CPL policy; current YourPace alternative-course classification or catalog exception remains unresolved.",
      "applicationResolved": false,
      "quotes": [
        {
          "sourceId": "umpi-current-cpl-policy-20261126",
          "text": "Students in Bachelor’s degree programs may earn a maximum of 30 credits."
        },
        {
          "sourceId": "umpi-current-cpl-policy-20261126",
          "text": "the combination of all forms of Credit for Prior Learning cannot exceed a total of 15 credits of an Associate’s degree and 30 credits of a Bachelor’s degree."
        }
      ]
    },
    {
      "id": "ace-classified-as-cpl-on-current-page",
      "value": true,
      "scope": "The current general ACE page directs official ACE records to CPL/PLA consideration. It does not state a YourPace-specific quantitative exception.",
      "quotes": [
        {
          "sourceId": "umpi-current-ace-cpl-policy-20261126",
          "text": "submit an official ACE transcript to the UMPI Registrar’s Office for Credit for Prior Learning Assessment (CPL) consideration."
        }
      ]
    },
    {
      "id": "published-bachelor-institutional-residency",
      "value": 30,
      "creditSystem": "semester",
      "quotes": [
        {
          "sourceId": "umpi-yourpace-faq-retained-20261125",
          "text": "Students must complete at least 30 credit hours through UMPI. At least 12 of these credits must be in the major, and at least 9 of those 12 credits must be at the upper level (300-level or above)."
        }
      ]
    },
    {
      "id": "outside-credit-floor-is-program-dependent",
      "scope": "The arithmetic outside ceiling is degree total minus the applicable institutional minimum; a 120-credit degree and a 90-credit applied degree must not inherit the same numeric ceiling.",
      "value": null,
      "quotes": [
        {
          "sourceId": "umpi-yourpace-faq-retained-20261125",
          "text": "Transfer credits are evaluated to determine how they apply toward your chosen program and degree requirements."
        }
      ]
    }
  ],
