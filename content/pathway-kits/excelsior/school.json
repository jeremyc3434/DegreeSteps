  "policies": {
    "oneAwardPerSourceCourse": {
      "value": true,
      "sourceIds": [
        "excelsior-grade-credit-application-policy",
        "excelsior-catalog-2026-11"
      ],
      "quotes": [
        {
          "sourceId": "excelsior-grade-credit-application-policy",
          "text": "When duplication is confirmed, only one of the sources of credit can be applied to the student’s Excelsior academic program."
        },
        {
          "sourceId": "excelsior-catalog-2026-11",
          "text": "A minimum total of 120 credits is required for bachelor’s degrees."
        }
      ],
      "basis": "A provider course may be listed under several requirements, but one completion supplies its credits once: Excelsior applies only one source for duplicated content and each degree needs 120 distinct credits."
    },
    "outsideCreditMinimumGrade": {
      "value": "C-",
      "sourceIds": [
        "excelsior-straighterline-equivalency-2024-12",
        "excelsior-sophia-equivalency-2025-03",
        "excelsior-studycom-equivalency-2024-12"
      ],
      "quotes": [
        {
          "sourceId": "excelsior-straighterline-equivalency-2024-12",
          "text": "Students must earn the equivalent of a C- or higher on outside sources of credit to be considered for applicability to an Excelsior degree program. All approved transfer credit will be transferred in as a “Pass” and will not factor in the Excelsior GPA."
        }
      ]
    },
    "upperLevelMinimum": {
      "value": 30,
      "creditSystem": "semester",
      "sourceIds": [
        "excelsior-catalog-2026-11",
        "excelsior-straighterline-equivalency-2024-12"
      ],
      "quotes": [
        {
          "sourceId": "excelsior-catalog-2026-11",
          "text": "All bachelor’s degree programs require a minimum of 30 hours to be completed at the upper level."
        },
        {
          "sourceId": "excelsior-straighterline-equivalency-2024-12",
          "text": "Excelsior requires completion of a minimum of 30 upper-level credits for all degree programs."
        }
      ]
    },
    "partnershipResidency": {
      "value": 15,
      "creditSystem": "semester",
      "sourceIds": [
        "excelsior-sophia-equivalency-2025-03",
        "excelsior-studycom-equivalency-2024-12",
        "excelsior-straighterline-equivalency-2024-12"
      ],
      "quotes": [
        {
          "sourceId": "excelsior-sophia-equivalency-2025-03",
          "text": "Partnership students admitted after December 31, 2024, will be required to complete a minimum of fifteen (15) Excelsior course credits prior to degree conferral."
        }
      ],
      "basis": "Applies to students admitted through a partnership, not to every student who transfers partner credit."
    },
    "nonCollegiateRecommendationWindow": {
      "value": true,
      "sourceIds": [
        "excelsior-transfer-credit-sources-policy"
      ],
      "quotes": [
        {
          "sourceId": "excelsior-transfer-credit-sources-policy",
          "text": "Learning experiences evaluated and recommended by NCCRS, or ACE must have been successfully completed during the period for which credit was recommended."
        }
      ]
    },
    "transferTimeLimit": {
      "value": null,
      "status": "conflicting",
      "sourceIds": [
        "excelsior-straighterline-equivalency-2024-12",
        "excelsior-grade-credit-application-policy"
      ],
      "quotes": [
        {
          "sourceId": "excelsior-straighterline-equivalency-2024-12",
          "text": "For all undergraduate degrees, except the BS Cybersecurity, BS Information Technology, and BS Computer Science, transfer credit must have been earned within 10 years prior to enrollment."
        },
        {
          "sourceId": "excelsior-grade-credit-application-policy",
          "text": "Generally, there is no time limit on the use of credit from approved sources of credit to satisfy the requirements of an Excelsior University degree program."
        }
      ]
    },
    "businessComponentTimeLimit": {
      "value": 15,
      "unit": "years",
      "sourceIds": [
        "excelsior-grade-credit-application-policy",
        "excelsior-straighterline-equivalency-2024-12"
      ],
      "quotes": [
        {
          "sourceId": "excelsior-straighterline-equivalency-2024-12",
          "text": "For the Bachelor of Science in business, credit being transferred into the business component must have been earned within 15 years prior to admission."
        }
      ]
    },
    "individualEvaluation": {
      "value": true,
      "sourceIds": [
        "excelsior-straighterline-equivalency-2024-12"
      ],
      "quotes": [
        {
          "sourceId": "excelsior-straighterline-equivalency-2024-12",
          "text": "Students will be reviewed individually, and official evaluations will be conducted at the time a student is admitted to Excelsior"
        }
      ]
    },
    "tuitionPerCredit": {
      "value": 510,
      "currency": "USD",
