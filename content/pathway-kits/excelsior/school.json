      ],
      "quotes": [
        {
          "sourceId": "excelsior-undergraduate-tuition",
          "text": "$510 per credit hour. Per credit tuition cost for all undergraduate courses."
        },
        {
          "sourceId": "excelsior-undergraduate-tuition",
          "text": "Academic Services Fee $40 per credit hour."
        },
        {
          "sourceId": "excelsior-undergraduate-tuition",
          "text": "Technology Fee $28 per course credit."
        },
        {
          "sourceId": "excelsior-undergraduate-tuition",
          "text": "Graduation Fee $125"
        }
      ]
    },
