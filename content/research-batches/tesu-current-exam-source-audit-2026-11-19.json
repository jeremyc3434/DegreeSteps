  "findings": [
    {
      "id": "specific-clep-policy-versus-provider-directory",
      "status": "needs-explicit-source-resolution",
      "detail": "The university publishes specific CLEP exam credit policy while College Board also appears in its provisional provider directory. Preserve both facts. Administrative provider-review status alone is not evidence of an exam ban; specific current exam awards, dates and personal conditions must establish actionability."
    },
    {
      "id": "sophia-provider-and-exact-award-separation",
      "status": "preserve-current-holds",
      "detail": "The Sophia TESU partner page displayed an empty established-equivalency table and listed courses without established agreements. Five separately reviewed institution-submitted ACE maps exist locally; these do not establish every Sophia course or clear provider review globally."
    },
    {
      "id": "source-versus-receiving-score",
      "status": "keep-separate",
      "detail": "College Board exam pages reviewed on the date above recommend score50 and3 semester hours, except College Composition recommends6. TESU current policy states C-equivalent, not a numeric50 threshold. Do not silently relabel the provider recommendation as a university-published numeric requirement."
    },
    {
      "id": "residency-and-source-caps",
      "status": "separate-verified-concepts",
      "detail": "The exact Liberal Studies ledger models120 credits,15 academic course-residency credits and105 derived outside credits, with a separate90 combined noncollegiate-credit ceiling. A waiver route is separate and is not activated by this packet. CLEP remains noncollegiate credit and does not fulfill TESU academic course residency."
    },
    {
      "id": "potential-reviewed-liberal-studies-basket",
      "status": "not-a-completed-plan",
      "detail": "Once current exact receiving maps are recovered, a CLEP-supported Liberal Studies route could reuse published21-credit general-education placements, eligible unrestricted electives and taxonomy/level-approved area allocations. Solver feasibility,18 upper-level area credits,1000-level allocation limits, source bundles and nonduplication must be verified before claiming any outside-credit total."
    }
