# Development/staging example. Do not put real secrets in this tracked file.
# Load values through your runtime or an ignored local environment file.

# Keep the current canonical host until a custom domain and callbacks are verified.
# DEGREEPATH_PUBLIC_ORIGIN=https://your-verified-staging-host.example

# Optional Supabase authentication in a dedicated development project.
PORTAL_SUPABASE_URL=
PORTAL_SUPABASE_PUBLISHABLE_KEY=
COMMUNITY_ADMIN_EMAIL=

# Local preview and existing D1-only development fixtures use d1.
# Production can select supabase after applying and verifying the reviewed
# Supabase migrations. The Worker forwards the verified user's JWT internally;
# no service-role key is used for the private portal data path.
PORTAL_STORAGE_BACKEND=d1

# Optional server-side AI connection. Prefer the managed encrypted connection
# for production. Never prefix a privileged key with NEXT_PUBLIC_ or VITE_.
ANTHROPIC_API_KEY=
AI_CONNECTIONS_MASTER_KEY=

# Paid-provider budgets should be chosen and tested explicitly.
# These scan limits can lower the current defaults; they do not provision capacity.
TRANSCRIPT_IMPORT_STUDENT_DAILY_LIMIT=3
TRANSCRIPT_IMPORT_DAILY_LIMIT=10
TEMPLATE_RESEARCH_DAILY_LIMIT=10

# Deployment gate for a separately provisioned Cloudflare account. Leave unset
# until existing D1 data, private account storage and the encrypted AI connection
# have been verified on the destination. This flag does not perform migration.
# DEGREESTEPS_DATA_MIGRATION_VERIFIED=1

# Existing local preview only; never expose its synthetic sign-in publicly.
DEGREEPATH_PREVIEW_PORT=8099

# Course-workspace homework rollout: independent prompt and native-cache switches.
# Other AI workflows are unchanged. No prompt/student text belongs in these values.
LEARNING_HOMEWORK_EXAMPLES_ENABLED=0
LEARNING_HOMEWORK_CACHE_ENABLED=0
