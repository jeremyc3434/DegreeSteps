{
  "name": "degreepath",
  "version": "0.6.0",
  "private": true,
  "scripts": {
    "build": "node scripts/build-community.mjs",
    "test": "node scripts/test-core.mjs",
    "test:core": "node scripts/test-core.mjs",
    "check:source": "node scripts/check-source-safety.mjs",
    "check:production": "node scripts/check-production-config.mjs",
    "benchmark:scale": "node scripts/benchmark-scale.mjs",
    "deploy:cloudflare": "node scripts/check-production-config.mjs && npm exec --yes --package=wrangler@4.164.0 -- wrangler deploy",
    "deploy:staging": "npm exec --yes --package=wrangler@4.164.0 -- wrangler deploy --config wrangler.staging.jsonc",
    "review:pathways": "node scripts/review-pathways.mjs",
    "review:pathways:snapshot": "node scripts/review-pathways.mjs --write",
    "coverage:build": "node scripts/build-academic-registry.mjs && node scripts/build-pathway-quality-report.mjs",
    "coverage:check": "node scripts/build-academic-registry.mjs --check && node scripts/build-pathway-quality-report.mjs --check",
    "research:school": "node scripts/build-school-research-batch.mjs",
    "db:generate": "drizzle-kit generate --config drizzle.config.mjs",
    "test:community": "node --test server/community.test.mjs",
    "factory:verify": "node scripts/pathway-factory/verify.mjs",
    "factory:compile": "node scripts/pathway-factory/compile.mjs",
    "factory:report": "node scripts/pathway-factory/report.mjs",
    "factory:draft": "node scripts/pathway-factory/draft.mjs",
    "factory:capture": "node scripts/pathway-factory/capture.mjs",
    "factory:publish": "node scripts/pathway-factory/compile.mjs --publish"
  },
  "devDependencies": {
    "drizzle-kit": "0.31.10",
    "drizzle-orm": "0.45.2",
    "esbuild": "0.25.12"
  },
  "dependencies": {
    "fflate": "0.8.3",
    "pdfjs-dist": "6.5.438",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  }
}
